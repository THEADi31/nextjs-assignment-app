datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  role      String     @default("MEMBER") // "ADMIN", "MEMBER", "GUEST"
  orders    Order[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  category    String
  price       Float
  isAvailable Boolean     @default(true)
  imageUrl    String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String      @default("PENDING") // "PENDING", "PREPARING", "READY", "COMPLETED", "CANCELLED"
  pickupSlot  String
  totalAmount Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Float
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(uuid())
  resendId  String   @unique
  recipient String
  status    String
  eventType String
  createdAt DateTime @default(now())
}